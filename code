def prepare_data_for_merge(df, date_col='Date'):
    if df is not None and not df.empty:
        df_copy = df.copy()
        if date_col in df_copy.columns:
            df_copy[date_col] = pd.to_datetime(df_copy[date_col])
            df_copy = df_copy.set_index(date_col)
        return df_copy
    return None


# Завдання 6
def merge_dataframes(*dfs, how='outer'):
    result = None
    for df in dfs:
        if df is not None and not df.empty:
            if result is None:
                result = df.copy()
            else:
                result = pd.merge(result, df, left_index=True, right_index=True, how=how)
    return result


